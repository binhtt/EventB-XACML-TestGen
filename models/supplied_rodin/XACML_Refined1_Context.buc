    <org.eventb.core.axiom name="1" org.eventb.core.label="axm4" org.eventb.core.predicate="policy_set_target ∈ POLICY_SET → ℙ(SUBJECT × RESOURCE × ACTION × ENVIRONMENT)"/>
    <org.eventb.core.axiom name="2" org.eventb.core.label="axm5" org.eventb.core.predicate="partition(&#13;&#10;    COMBINING_ALGORITHM,&#13;&#10;    {PermitOverrides},&#13;&#10;    {DenyOverrides},&#13;&#10;    {FirstApplicable}&#13;&#10;)"/>
